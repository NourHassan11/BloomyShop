@model Project.DAL.Entities.Admin

@{
    ViewData["Title"] = "Admin Details";
}

<h1>Admin Details</h1>

<div>
    <h4>Admin</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">Admin ID</dt>
        <dd class="col-sm-9">@Model.AdminID</dd>

        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.AdminID"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>
