@model IEnumerable<Project.DAL.Entities.Admin>

@{
    ViewData["Title"] = "Manage Admins";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Manage Admins</h1>

        <a asp-action="Create"
           class="btn btn-primary">
            Create New Admin
        </a>

    </div>

    <table class="table table-bordered table-hover">

        <thead>
            <tr>
                <th>Admin ID</th>
                <th>Full Name</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var admin in Model)
            {
                <tr>

                    <td>
                        @admin.AdminID
                    </td>

                    <td>
                        @admin.FullName
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@admin.AdminID"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@admin.AdminID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@admin.AdminID"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>
