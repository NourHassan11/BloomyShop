@model IEnumerable<Project.DAL.Entities.Admin>

@{
    ViewData["Title"] = "Admins";
}

<h1>Admins</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Admin
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Admin ID</th>
            <th>Full Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var admin in Model)
        {
            <tr>
                <td>@admin.AdminID</td>
                <td>@admin.FullName</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@admin.AdminID"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@admin.AdminID"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@admin.AdminID"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-action="EventRequests" class="btn btn-success">
        Manage Event Requests
    </a>
</p>
