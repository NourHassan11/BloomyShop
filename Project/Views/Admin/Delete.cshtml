@model Project.DAL.Entities.Admin

@{
    ViewData["Title"] = "Delete Admin";
}

<h1>Delete Admin</h1>

<h3>Are you sure you want to delete this admin?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">Admin ID</dt>
        <dd class="col-sm-9">@Model.AdminID</dd>

        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="AdminID" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>