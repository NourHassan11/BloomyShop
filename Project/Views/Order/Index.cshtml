@model IEnumerable<Project.DAL.Entities.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-5">
    <h2>My Orders</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no past orders.</div>
    }
    else
    {
        <table class="table table-bordered table-striped mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Order Date</th>
                    <th>Status</th>
                    <th>Total Price</th>
                    <th>Delivery Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@order.Status</td>
                        <td>@order.TotalPrice EGP</td>
                        <td>@order.DeliveryAddress</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.OrderID" class="btn btn-info btn-sm">View Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>