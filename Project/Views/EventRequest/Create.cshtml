@model Project.ViewModels.EventRequestCreateViewModel

@{
    ViewData["Title"] = "Create Event Request";
}

<h1>Create Event Request</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="CustomerID">Customer</label>
        <select asp-for="CustomerID" asp-items="Model.Customers">
            <option value="">-- Select Customer --</option>
        </select>
        <span asp-validation-for="CustomerID"></span>
    </div>

    <br />

    <div>
        <label asp-for="LocationType">Location</label>
        <select asp-for="LocationType">
            <option value="">-- Select Location --</option>
            <option value="Indoor">Indoor</option>
            <option value="Outdoor">Outdoor</option>
        </select>
        <span asp-validation-for="LocationType"></span>
    </div>

    <br />

    <div>
        <label asp-for="NumberOfGuests">Number of Guests</label>
        <input asp-for="NumberOfGuests" type="number" />
        <span asp-validation-for="NumberOfGuests"></span>
    </div>

    <br />

    <div>
        <label asp-for="EventDate">Event Date</label>
        <input asp-for="EventDate" type="date" />
        <span asp-validation-for="EventDate"></span>
    </div>

    <br />

    <div>
        <label asp-for="OccasionID">Occasion</label>
        <select asp-for="OccasionID" asp-items="Model.Occasions">
            <option value="">-- Select Occasion --</option>
        </select>
        <span asp-validation-for="OccasionID"></span>
    </div>

    <br />

    <div>
        <label asp-for="Theme">Theme</label>
        <input asp-for="Theme" type="text" />
        <span asp-validation-for="Theme"></span>
    </div>

    <br />

    <div>
        <label asp-for="Budget">Budget</label>
        <input asp-for="Budget" type="number" step="0.01" />
        <span asp-validation-for="Budget"></span>
    </div>

    <br />

    <div>
        <label>Decoration Types</label>

        @foreach (var decoration in Model.DecorationTypes!)
        {
            <div>
                <input type="checkbox"
                       name="DecorationTypeIDs"
                       value="@decoration.Value" />

                <label>@decoration.Text</label>
            </div>
        }
    </div>

    <br />

    <button type="submit">Create Request</button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
