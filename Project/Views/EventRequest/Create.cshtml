@model Project.ViewModels.EventRequestCreateViewModel

@{
    ViewData["Title"] = "Event Booking & Consultation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="event-page">

    <!-- Hero Header -->
    <header class="event-hero">
        <div class="event-hero-text">
            <div class="bloomy-subheading mb-3">⚲ Bespoke Floral Architecture</div>
            <h1>Let's Make Your <br><em>Event Bloom.</em></h1>
            <p class="event-hero-desc">
                Tell us about your event and our team of floral architects will craft an unforgettable botanical setting
                tailored to your vision. From grand ballroom canopies to whispered candlelight tablescapes.
            </p>
            <div class="event-hero-badges">
                <span class="event-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    Free Consultation
                </span>
                <span class="event-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    Tailored Styling
                </span>
                <span class="event-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    White-Glove Setup
                </span>
            </div>
        </div>
        <div class="event-hero-img-wrap">
            <img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=800&q=80" alt="Event Setup"
                 onerror="this.src='/images/romantic-roses.jpg'" />
            <div class="event-hero-img-tag">
                <h4>Next Availability</h4>
                <p>Spring & Summer 2026 <span class="tag-status">● Booking Open</span></p>
            </div>
        </div>
    </header>

    <form id="eventForm"
          asp-action="Create"
          asp-controller="EventRequest"
          method="post"
          enctype="multipart/form-data"
          class="event-layout">

        <!-- Hidden input for the combined Theme/Notes/Palette string -->
        <input type="hidden" asp-for="Theme" id="HiddenTheme" />

        <div class="event-form-main">

            <!-- SECTION 1: Event Essentials -->
            <section class="event-form-section">
                <div class="event-section-header">
                    <div class="event-section-num">1</div>
                    <div class="event-section-title">
                        <h2>Event Essentials</h2>
                        <p>The core details anchoring your special celebration</p>
                    </div>
                </div>

                <div class="event-form-group">
                    <label class="event-label">What Occasion Is This? *</label>
                    <select asp-for="OccasionID" asp-items="Model.Occasions" class="event-select" id="uiOccasion" required>
                        <option value="">Select your celebration type...</option>
                    </select>
                    <span asp-validation-for="OccasionID" class="text-danger" style="font-size:0.75rem;"></span>
                </div>

                <div class="event-row">
                    <div class="event-form-group">
                        <label class="event-label">Event Date *</label>
                        <input asp-for="EventDate" type="date" class="event-input" id="uiDate" required />
                        <span asp-validation-for="EventDate" class="text-danger" style="font-size:0.75rem;"></span>
                    </div>
                    <div class="event-form-group">
                        <label class="event-label">Guest Arrival Time *</label>
                        <input type="time" class="event-input" id="uiTime" required />
                    </div>
                </div>

                <div class="event-form-group">
                    <label class="event-label">Venue Name & Full Address *</label>
                    <input asp-for="LocationType" type="text" class="event-input"
                           placeholder="e.g. The Glass House, 550 12th Ave, New York, NY" required />
                    <span asp-validation-for="LocationType" class="text-danger" style="font-size:0.75rem;"></span>
                </div>

                <div class="event-form-group guest-slider-wrap">
                    <div class="guest-slider-header">
                        <label class="event-label" style="margin:0;">Guest Count</label>
                        <span class="guest-slider-val"><span id="guestDisplay">150</span> Attendees</span>
                    </div>
                    <input asp-for="NumberOfGuests" type="hidden" id="HiddenGuests" value="150" />
                    <input type="range" min="10" max="500" value="150" class="guest-range" id="guestSlider"
                           oninput="document.getElementById('guestDisplay').innerText = this.value; document.getElementById('HiddenGuests').value = this.value; updateSummary();" />
                    <div class="guest-slider-marks">
                        <span>10 (Intimate)</span>
                        <span>150</span>
                        <span>300</span>
                        <span>500+ (Grand Gala)</span>
                    </div>
                </div>

                <div class="event-form-group mt-4">
                    <label class="event-label">Estimated Floral Budget *</label>
                    <input asp-for="Budget" type="hidden" id="HiddenBudget" value="2000" />
                    <div class="budget-cards">
                        <label class="budget-card">
                            <input type="radio" name="uiBudget" value="1000"
                                   onchange="document.getElementById('HiddenBudget').value = this.value; updateSummary();" />
                            <span class="budget-card-label">$500 - $1,500</span>
                        </label>
                        <label class="budget-card active">
                            <input type="radio" name="uiBudget" value="2000" checked
                                   onchange="document.getElementById('HiddenBudget').value = this.value; updateSummary();" />
                            <span class="budget-card-label">$1,500 - $3,000</span>
                        </label>
                        <label class="budget-card">
                            <input type="radio" name="uiBudget" value="5000"
                                   onchange="document.getElementById('HiddenBudget').value = this.value; updateSummary();" />
                            <span class="budget-card-label">$3,000 - $7,500</span>
                        </label>
                        <label class="budget-card">
                            <input type="radio" name="uiBudget" value="10000"
                                   onchange="document.getElementById('HiddenBudget').value = this.value; updateSummary();" />
                            <span class="budget-card-label">$7,500+ (Bespoke)</span>
                        </label>
                    </div>
                </div>
            </section>

            <!-- SECTION 2: Decoration Scope -->
            <section class="event-form-section">
                <div class="event-section-header">
                    <div class="event-section-num">2</div>
                    <div class="event-section-title">
                        <h2>Decoration & Floral Scope</h2>
                        <p>Select all elements vital to your architectural vision</p>
                    </div>
                </div>

                <div class="decoration-grid">
                    @if (Model.DecorationTypes != null)
                    {
                        foreach (var dec in Model.DecorationTypes)
                        {
                            <label class="decoration-card">
                                <input type="checkbox" name="DecorationTypeIDs" value="@dec.Value" class="dec-checkbox"
                                       onchange="updateSummary()" />
                                <div class="decoration-card-inner">
                                    <div class="dec-check"></div>
                                    <div class="dec-icon">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 2v20"></path>
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                        </svg>
                                    </div>
                                    <h4>@dec.Text</h4>
                                    <p>Select to include in scope</p>
                                </div>
                            </label>
                        }
                    }
                </div>
            </section>

            <!-- SECTION 3: Color Palette & Moodboard -->
            <section class="event-form-section">
                <div class="event-section-header">
                    <div class="event-section-num">3</div>
                    <div class="event-section-title">
                        <h2>Color Palette & Moodboard</h2>
                        <p>Infuse the aesthetic heart into the botanical story</p>
                    </div>
                </div>

                <label class="event-label">Choose Your Color Story *</label>
                <div class="palette-grid">
                    <label class="palette-card">
                        <input type="radio" name="uiPalette" value="Burgundy & Soft Rose" checked onchange="updateTheme()" />
                        <div class="palette-card-inner">
                            <div class="palette-colors">
                                <span style="background:#6B2D40;"></span>
                                <span style="background:#8F3D56;"></span>
                                <span style="background:#E8A4B8;"></span>
                                <span style="background:#F5E6EB;"></span>
                            </div>
                            <h4>Burgundy & Soft Rose</h4>
                            <p>Dramatic, romantic, & poetic</p>
                        </div>
                    </label>
                    <label class="palette-card">
                        <input type="radio" name="uiPalette" value="Emerald & Custom Sage" onchange="updateTheme()" />
                        <div class="palette-card-inner">
                            <div class="palette-colors">
                                <span style="background:#2C4C3B;"></span>
                                <span style="background:#4A7C59;"></span>
                                <span style="background:#7C9B8A;"></span>
                                <span style="background:#E1EFE6;"></span>
                            </div>
                            <h4>Emerald & Custom Sage</h4>
                            <p>Lush, organic, & architectural foliage</p>
                        </div>
                    </label>
                    <label class="palette-card">
                        <input type="radio" name="uiPalette" value="White & Champagne" onchange="updateTheme()" />
                        <div class="palette-card-inner">
                            <div class="palette-colors">
                                <span style="background:#FFFFFF; border: 1px solid #ddd;"></span>
                                <span style="background:#F8F4EF;"></span>
                                <span style="background:#E8E2DC;"></span>
                                <span style="background:#D4C5B9;"></span>
                            </div>
                            <h4>White & Champagne</h4>
                            <p>Timeless, luminous, & pristine grace</p>
                        </div>
                    </label>
                    <label class="palette-card">
                        <input type="radio" name="uiPalette" value="Terracotta Warmth" onchange="updateTheme()" />
                        <div class="palette-card-inner">
                            <div class="palette-colors">
                                <span style="background:#A44A3F;"></span>
                                <span style="background:#F19C79;"></span>
                                <span style="background:#F6D8CE;"></span>
                                <span style="background:#FAF0E6;"></span>
                            </div>
                            <h4>Tuscan Terracotta</h4>
                            <p>Sun-drenched, earthy, & warm harvest</p>
                        </div>
                    </label>
                </div>

                <label class="event-label">Inspiration / Moodboard Uploads</label>
                <div class="upload-area" id="uploadDropzone" onclick="document.getElementById('fileUploadInput').click();">
                    <input type="file" id="fileUploadInput" name="Attachments" multiple style="display:none;" onchange="handleFileSelect(this)" />
                    <div class="upload-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                    </div>
                    <p id="uploadText">Drag & Drop Pinterest boards, sketches, or venue photos</p>
                    <span id="uploadSubtext">Accepts JPG, PNG, PDF up to 20MB each</span>
                </div>
            </section>

            <!-- SECTION 4: Contact & Atelier Consultation -->
            <section class="event-form-section">
                <div class="event-section-header">
                    <div class="event-section-num">4</div>
                    <div class="event-section-title">
                        <h2>Contact & Atelier Consultation</h2>
                        <p>How our lead floral director may connect directly with you</p>
                    </div>
                </div>

                <div class="event-form-group">
                    <label class="event-label">Select Customer Profile *</label>
                    <select asp-for="CustomerID" asp-items="Model.Customers" class="event-select" required>
                        <option value="">-- Choose Profile --</option>
                    </select>
                    <span asp-validation-for="CustomerID" class="text-danger" style="font-size:0.75rem;"></span>
                    <p style="font-size:0.75rem; color:var(--bloomy-warm-gray, #666); margin-top:0.5rem;">
                        For new clients, please create a profile first.
                    </p>
                </div>

                <div class="event-row">
                    <div class="event-form-group">
                        <label class="event-label">Phone Number *</label>
                        <input type="tel" class="event-input" placeholder="+1 (555) 123-4567" required />
                    </div>
                    <div class="event-form-group">
                        <label class="event-label">Preferred Consultation Method</label>
                        <div class="budget-cards">
                            <label class="budget-card">
                                <input type="radio" name="uiContactPref" value="Atelier Visit" checked onchange="updateTheme()" />
                                <span class="budget-card-label" style="padding:0.75rem;">Atelier Visit</span>
                            </label>
                            <label class="budget-card">
                                <input type="radio" name="uiContactPref" value="Video Call" onchange="updateTheme()" />
                                <span class="budget-card-label" style="padding:0.75rem;">Video Call</span>
                            </label>
                            <label class="budget-card">
                                <input type="radio" name="uiContactPref" value="Phone Call" onchange="updateTheme()" />
                                <span class="budget-card-label" style="padding:0.75rem;">Phone Call</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="event-form-group">
                    <label class="event-label">Additional Notes & Special Requests</label>
                    <textarea class="event-textarea" id="uiNotes" rows="4"
                              placeholder="Tell us about favorite flower varieties, fragrance allergies, venue loading constraints, or any personal sentimental details..."
                              oninput="updateTheme()"></textarea>
                </div>
            </section>
        </div>

        <!-- Sidebar Summary -->
        <aside class="event-sidebar">
            <div class="summary-card">
                <div class="summary-header">
                    <h3>Your Event Summary</h3>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>

                <div class="summary-item">
                    <span class="summary-item-label">Estimated Budget</span>
                    <span class="summary-item-val" id="sumBudget">$1,500 - $3,000</span>
                </div>
                <div class="summary-item">
                    <span class="summary-item-label">Est. Guest Count</span>
                    <span class="summary-item-val" id="sumGuests">150 Attendees</span>
                </div>
                <div class="summary-item">
                    <span class="summary-item-label">Color Story</span>
                    <span class="summary-item-val" id="sumPalette">Burgundy & Soft Rose</span>
                </div>
                <div class="summary-item">
                    <span class="summary-item-label">Consultation Type</span>
                    <span class="summary-item-val" id="sumContact">Atelier Visit</span>
                </div>
                <div class="summary-item" style="border-top: 1px solid var(--bloomy-light-gray, #eee); padding-top: 1rem; margin-top: 1rem;">
                    <span class="summary-item-label">Floral Scope</span>
                    <span class="summary-item-val" id="sumScope">0 Selected</span>
                </div>

                <div class="summary-guarantee">
                    <div class="summary-guarantee-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div class="summary-guarantee-text">
                        <h4>Fresh Floral Guarantee</h4>
                        <p>Luxury conditioned blooms with 72-hr longevity reserve.</p>
                    </div>
                </div>

                <button type="submit" class="btn-submit-event">
                    Submit Event Request
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>

                <div class="summary-footer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    We appreciate 24 hours to draft an initial custom moodboard & proposal.
                </div>

                <div class="summary-contact-card">
                    <img src="~/images/events-hero.jpg" alt="Director" onerror="this.src='/images/romantic-roses.jpg'" />
                    <div class="summary-contact-info">
                        <h4>Camille Laurent</h4>
                        <p>Director of Bespoke Installations</p>
                        <p style="font-style:italic; font-size:0.625rem; margin-top:0.25rem;">"Every stem chosen to echo your unique narrative."</p>
                    </div>
                </div>
            </div>
        </aside>
    </form>

    <!-- Bottom Galleries Section -->
    <section class="event-gallery">
        <div class="event-gallery-header">
            <div>
                <div class="bloomy-subheading mb-2">THE ARCHIVES</div>
                <h2>Curated Gatherings</h2>
            </div>
            <p>A glimpse into private celebrations and botanical installations thoughtfully realized by our atelier.</p>
        </div>

        <div class="event-gallery-grid">
            <article class="gallery-card">
                <div class="gallery-img-wrap">
                    <span class="gallery-tag">Estate Wedding</span>
                    <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=600&q=80" alt="Wedding" onerror="this.src='/images/romantic-roses.jpg'" />
                </div>
                <h3>The Hudson Valley Nuptials</h3>
                <p>Wild smilax, trailing ivy, and Juliet roses set heritage garden aisles.</p>
                <p class="gallery-quote">
                    "Bloomy transformed our historic greenhouse into an ethereal midsummer dream."<br>
                    <span style="font-size:0.625rem;font-weight:700;font-style:normal;letter-spacing:0.1em;text-transform:uppercase;">— SYDNEY & MARCUS</span>
                </p>
            </article>

            <article class="gallery-card">
                <div class="gallery-img-wrap">
                    <span class="gallery-tag">Bespoke Gala</span>
                    <img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=80" alt="Gala" onerror="this.src='/images/romantic-roses.jpg'" />
                </div>
                <h3>The 10th Solstice Gala</h3>
                <p>Suspended floral clouds of white lunaria, white burgundy amaranth, and tulipa lily-flowered.</p>
                <p class="gallery-quote">
                    "The ceiling installation took our breath away. Guests talked about it for weeks."<br>
                    <span style="font-size:0.625rem;font-weight:700;font-style:normal;letter-spacing:0.1em;text-transform:uppercase;">— JULIAN STERLING</span>
                </p>
            </article>

            <article class="gallery-card">
                <div class="gallery-img-wrap">
                    <span class="gallery-tag">Private Dinner</span>
                    <img src="https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?w=600&q=80" alt="Dinner" onerror="this.src='/images/romantic-roses.jpg'" />
                </div>
                <h3>The Provence Solarium Gathering</h3>
                <p>Table meadows featuring botanical sweet peas, ranunculus, and wild olive boughs.</p>
                <p class="gallery-quote">
                    "Intimate, fragrant, and exquisitely crafted. An effortless mastery."<br>
                    <span style="font-size:0.625rem;font-weight:700;font-style:normal;letter-spacing:0.1em;text-transform:uppercase;">— CLAIRE DELACROIX</span>
                </p>
            </article>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateSummary() {
            // Guests
            const guestsInput = document.getElementById('HiddenGuests');
            if (guestsInput) {
                document.getElementById('sumGuests').innerText = guestsInput.value + " Attendees";
            }

            // Budget
            const budgetRadios = document.getElementsByName('uiBudget');
            let budgetText = "Not Selected";
            for (const r of budgetRadios) {
                if (r.checked) {
                    budgetText = r.nextElementSibling ? r.nextElementSibling.innerText : r.value;
                    break;
                }
            }
            const sumBudget = document.getElementById('sumBudget');
            if (sumBudget) sumBudget.innerText = budgetText;

            // Scope Count
            const checks = document.querySelectorAll('.dec-checkbox:checked');
            const sumScope = document.getElementById('sumScope');
            if (sumScope) sumScope.innerText = checks.length + " Selected";
        }

        function updateTheme() {
            // Combine Palette + Contact Pref + Notes into Theme hidden field
            const palette = document.querySelector('input[name="uiPalette"]:checked')?.value || "None";
            const contact = document.querySelector('input[name="uiContactPref"]:checked')?.value || "None";
            const notesInput = document.getElementById('uiNotes');
            const notes = notesInput ? notesInput.value.trim() : "";

            const sumPalette = document.getElementById('sumPalette');
            if (sumPalette) sumPalette.innerText = palette;

            const sumContact = document.getElementById('sumContact');
            if (sumContact) sumContact.innerText = contact;

            const finalTheme = `Palette: ${palette} | Pref: ${contact} | Notes: ${notes}`;

            const hiddenTheme = document.getElementById('HiddenTheme');
            if (hiddenTheme) {
                hiddenTheme.value = finalTheme;
            }
        }

        function handleFileSelect(input) {
            const textElement = document.getElementById('uploadText');
            const subtextElement = document.getElementById('uploadSubtext');

            if (input.files && input.files.length > 0) {
                textElement.innerText = `${input.files.length} file(s) selected`;
                subtextElement.innerText = Array.from(input.files).map(f => f.name).join(', ');
            } else {
                textElement.innerText = "Drag & Drop Pinterest boards, sketches, or venue photos";
                subtextElement.innerText = "Accepts JPG, PNG, PDF up to 20MB each";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            updateSummary();
            updateTheme();

            const form = document.getElementById('eventForm');
            if (form) {
                form.addEventListener('submit', () => {
                    updateTheme();
                    updateSummary();
                });
            }
        });
    </script>
}