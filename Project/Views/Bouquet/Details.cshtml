@model Project.DAL.Entities.Bouquet

@{
    ViewData["Title"] = "Bouquet Details";
}

<h1>@Model.Name</h1>

<div class="row">
    <div class="col-md-6">
        <img src="@Model.Image"
             class="img-fluid"
             alt="@Model.Name" />
    </div>

    <div class="col-md-6">
        <h2>@Model.Name</h2>

        <p>@Model.Description</p>

        <p>
            <strong>Price:</strong>
            @Model.Price
        </p>

        <p>
            <strong>Size:</strong>
            @Model.BouquetSize.Size
        </p>

        <p>
            <strong>Preparation Time:</strong>
            @Model.PreparationTime
        </p>

        <h4>Flowers</h4>

        <ul>
            @foreach (var item in Model.BouquetFlowers)
            {
                <li>@item.Flower.Name</li>
            }
        </ul>

        <a asp-controller="Bouquet"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>
</div>