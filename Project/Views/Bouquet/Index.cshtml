@model IEnumerable<Project.DAL.Entities.Bouquet>

@{
    ViewData["Title"] = "Ready-Made Bouquets";
}

<h1>Ready-Made Bouquets</h1>

<form asp-action="Index" method="get" class="mb-4">

    <div class="row">

        <div class="col-md-5">
            <input type="text"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Search by bouquet or flower name..." />
        </div>

        <div class="col-md-4">
            <select name="sizeId" class="form-control">
                <option value="">-- All Sizes --</option>

                @foreach (var size in ViewBag.Sizes)
                {
                    <option value="@size.SizeID"
                            selected="@(ViewBag.SelectedSize == size.SizeID)">
                        @size.Size
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>
        </div>

    </div>

</form>

<div class="row">
    @foreach (var bouquet in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">

                <img src="@bouquet.Image"
                     class="card-img-top"
                     alt="@bouquet.Name"
                     style="height:250px; object-fit:cover;" />

                <div class="card-body">

                    <h5 class="card-title">
                        @bouquet.Name
                    </h5>

                    <p class="card-text">
                        @bouquet.Description
                    </p>

                    <p>
                        <strong>Price:</strong>
                        @bouquet.Price
                    </p>

                    <p>
                        <strong>Size:</strong>
                        @bouquet.BouquetSize.Size
                    </p>

                    <p>
                        <strong>Preparation Time:</strong>
                        @bouquet.PreparationTime
                    </p>

                    <a asp-controller="Bouquet"
                       asp-action="Details"
                       asp-route-id="@bouquet.BouquetID"
                       class="btn btn-primary">
                        View Details
                    </a>

                </div>
            </div>
        </div>
    }
</div>