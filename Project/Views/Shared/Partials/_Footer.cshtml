<footer class="bloomy-footer">
    <div class="bloomy-container">
        <div class="bloomy-footer-grid">

            <!-- Brand Column -->
            <div>
                <div class="bloomy-footer-brand-name">Bloomy Shop</div>
                <div class="bloomy-footer-brand-tagline">Botanical Studio</div>
                <p class="bloomy-footer-desc">
                    Handcrafted floral arrangements made with the finest seasonal stems.
                    From intimate gifts to grand event installations — every bloom tells a story.
                </p>
                <div class="bloomy-footer-social">
                    <a href="#" class="bloomy-social-btn" aria-label="Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    </a>
                    <a href="#" class="bloomy-social-btn" aria-label="Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                        </svg>
                    </a>
                    <a href="#" class="bloomy-social-btn" aria-label="Pinterest">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.77 1.24-5.26 1.24-5.26s-.32-.63-.32-1.57c0-1.47.86-2.57 1.92-2.57.91 0 1.35.68 1.35 1.5 0 .91-.58 2.28-.88 3.55-.25 1.06.53 1.92 1.57 1.92 1.88 0 3.14-2.41 3.14-5.26 0-2.17-1.47-3.79-4.11-3.79-2.99 0-4.84 2.24-4.84 4.74 0 .86.25 1.47.64 1.94.18.22.2.31.14.56-.05.18-.16.61-.2.78-.07.25-.28.34-.51.25-1.39-.57-2.04-2.1-2.04-3.82 0-2.83 2.4-6.22 7.14-6.22 3.81 0 6.33 2.77 6.33 5.74 0 3.93-2.17 6.87-5.37 6.87-1.07 0-2.08-.57-2.43-1.22l-.66 2.55c-.24.92-.88 2.07-1.31 2.77.99.3 2.04.46 3.12.46 5.52 0 10-4.48 10-10S17.52 2 12 2z"></path>
                        </svg>
                    </a>
                    <a href="#" class="bloomy-social-btn" aria-label="TikTok">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Shop Column -->
            <div>
                <h3 class="bloomy-footer-col-title">Shop</h3>
                <ul class="bloomy-footer-links">
                    <li><a asp-controller="Bouquet" asp-action="Index" class="bloomy-footer-link">Fresh Bouquets</a></li>
                    <li><a asp-controller="Bouquet" asp-action="Index" class="bloomy-footer-link">Seasonal Collections</a></li>
                    <li><a asp-controller="Bouquet" asp-action="Index" class="bloomy-footer-link">Bestsellers</a></li>
                    <li><a asp-controller="CustomizedBouquet" asp-action="Index" class="bloomy-footer-link">Custom Designs</a></li>
                    <li><a asp-controller="Bouquet" asp-action="Index" class="bloomy-footer-link">Gift Sets</a></li>
                </ul>
            </div>

            <!-- Company Column -->
            <div>
                <h3 class="bloomy-footer-col-title">Company</h3>
                <ul class="bloomy-footer-links">
                    <li><a asp-controller="Home" asp-action="Privacy" class="bloomy-footer-link">About Us</a></li>
                    <li><a asp-controller="EventRequest" asp-action="Create" class="bloomy-footer-link">Events</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" class="bloomy-footer-link">Our Story</a></li>
                    <li><a asp-controller="Customer" asp-action="Login" class="bloomy-footer-link">My Account</a></li>
                    <li><a asp-controller="Order" asp-action="Index" class="bloomy-footer-link">Track Order</a></li>
                </ul>
            </div>

            <!-- Contact Column -->
            <div>
                <h3 class="bloomy-footer-col-title">Get in Touch</h3>
                <div style="display:flex;flex-direction:column;gap:1rem;">
                    <div style="display:flex;gap:0.75rem;align-items:flex-start;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span style="font-size:0.875rem;font-family:var(--font-sans);color:rgba(255,255,255,0.52);line-height:1.6;">123 Floral Lane, Garden District<br>Cairo, Egypt</span>
                    </div>
                    <div style="display:flex;gap:0.75rem;align-items:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.58 3.38 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <a href="tel:+201234567890" class="bloomy-footer-link">+20 123 456 7890</a>
                    </div>
                    <div style="display:flex;gap:0.75rem;align-items:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <a href="mailto:hello@bloomyshop.com" class="bloomy-footer-link">hello@bloomyshop.com</a>
                    </div>
                    <div style="margin-top:0.5rem;">
                        <p style="font-family:var(--font-sans);font-size:0.6875rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.38);margin-bottom:0.5rem;">Hours</p>
                        <p style="font-size:0.875rem;font-family:var(--font-sans);color:rgba(255,255,255,0.52);line-height:1.7;margin:0;">Mon &ndash; Fri: 9am &ndash; 7pm<br>Sat &ndash; Sun: 10am &ndash; 5pm</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Strip -->
        <div class="bloomy-footer-bottom">
            <p class="bloomy-footer-copy">&copy; @DateTime.Now.Year Bloomy Shop. All rights reserved. Made with ♡ for flowers.</p>
            <div class="bloomy-footer-legal">
                <a href="#" class="bloomy-footer-legal-link">Privacy Policy</a>
                <a href="#" class="bloomy-footer-legal-link">Terms of Service</a>
                <a href="#" class="bloomy-footer-legal-link">Cookies</a>
            </div>
        </div>
    </div>
</footer>
