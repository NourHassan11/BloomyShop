<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Bloomy Shop — Premium botanical studio offering hand-crafted bouquets, custom floral arrangements, and event floristry.")" />
    <title>@ViewData["Title"] - Bloomy Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("Partials/_Header")

    <!-- Search Modal -->
    <div id="bloomySearchModal" class="bloomy-search-modal" role="dialog" aria-label="Search" aria-modal="true">
        <div class="bloomy-search-box">
            <p class="bloomy-subheading mb-3">Search Our Collection</p>
            <input id="bloomySearchInput" type="text" class="bloomy-search-input" placeholder="Type to search bouquets..." autocomplete="off" />
            <p style="font-size:0.75rem;color:var(--bloomy-warm-gray);margin-top:1rem;">Press <kbd>Esc</kbd> to close</p>
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Partials/_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
