@model Project.ViewModels.CustomizedBouquetViewModel

@{
    ViewData["Title"] = "Customize Your Bouquet";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <style>
        .custom-page {
            background: #fff8f6;
            min-height: calc(100vh - 80px);
            padding: 50px 20px 80px;
            font-family: 'Inter', sans-serif;
            color: #1e1b1a;
        }

        .custom-container {
            max-width: 1100px;
            margin: auto;
        }

        .custom-hero {
            text-align: center;
            margin-bottom: 45px;
        }

        .custom-eyebrow {
            color: #4e644a;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .custom-title {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            font-weight: 400;
            color: #72263f;
            margin-bottom: 12px;
        }

        .custom-subtitle {
            max-width: 650px;
            margin: auto;
            color: #534246;
            font-size: 15px;
            line-height: 1.7;
        }

        .custom-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 32px;
            margin-bottom: 24px;
            box-shadow: 0 3px 16px rgba(41, 37, 36, 0.06);
        }

        .custom-section-title {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .custom-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f5ecea;
            color: #72263f;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-section-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 500;
            margin: 0;
        }

        .custom-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #867276;
            margin-bottom: 8px;
        }

        .custom-select {
            width: 100%;
            height: 50px;
            padding: 0 14px;
            border: 1px solid #d9c1c5;
            border-radius: 8px;
            background: #fff8f6;
            color: #1e1b1a;
            font-family: 'Inter', sans-serif;
            outline: none;
        }

            .custom-select:focus {
                border-color: #72263f;
                box-shadow: 0 0 0 2px rgba(114, 38, 63, 0.08);
            }

        .custom-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

        .custom-option {
            position: relative;
        }

            .custom-option input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .custom-option label {
                display: flex;
                flex-direction: column;
                gap: 5px;
                padding: 16px;
                min-height: 75px;
                border: 1px solid #d9c1c5;
                border-radius: 10px;
                background: #fff8f6;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .custom-option label:hover {
                    border-color: #72263f;
                    transform: translateY(-1px);
                }

            .custom-option input:checked + label {
                border-color: #72263f;
                background: #f5ecea;
                box-shadow: 0 0 0 2px rgba(114, 38, 63, 0.08);
            }

        .option-name {
            font-weight: 600;
            color: #1e1b1a;
        }

        .option-price {
            font-size: 13px;
            color: #4e644a;
        }

        .custom-actions {
            display: flex;
            justify-content: center;
            margin-top: 32px;
        }

        .custom-submit {
            min-width: 260px;
            height: 50px;
            padding: 0 28px;
            border: none;
            border-radius: 8px;
            background: #72263f;
            color: white;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
        }

            .custom-submit:hover {
                background: #8f3d56;
                transform: translateY(-1px);
            }

        .validation-box {
            margin-bottom: 24px;
        }

            .validation-box ul {
                margin-bottom: 0;
            }

        @@media (max-width: 600px) {
            .custom-page {
                padding: 35px 15px 60px;
            }

            .custom-title {
                font-size: 32px;
            }

            .custom-card {
                padding: 22px;
            }

            .custom-options {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="custom-page">

    <div class="custom-container">

        <!-- Hero -->
        <div class="custom-hero">

            <div class="custom-eyebrow">
                Botanical Atelier
            </div>

            <h1 class="custom-title">
                Create Your Bouquet
            </h1>

            <p class="custom-subtitle">
                Choose every detail of your arrangement and create
                a bouquet designed especially for you.
            </p>

        </div>


        <form asp-action="Customize" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger validation-box">
            </div>


            <!-- Size -->
            <div class="custom-card">

                <div class="custom-section-title">

                    <div class="custom-icon">
                        <span class="material-symbols-outlined">
                            unfold_more
                        </span>
                    </div>

                    <h2>
                        Choose Your Size
                    </h2>

                </div>

                <label class="custom-label">
                    Bouquet Size
                </label>

                <select asp-for="SizeID"
                        class="custom-select">

                    <option value="">
                        Select a size
                    </option>

                    @foreach (var size in ViewBag.Sizes)
                    {
                        <option value="@size.SizeID">
                            @size.Size — @size.BasePrice EGP
                        </option>
                    }

                </select>

                <span asp-validation-for="SizeID"
                      class="text-danger">
                </span>

            </div>


            <!-- Wrapping -->
            <div class="custom-card">

                <div class="custom-section-title">

                    <div class="custom-icon">
                        <span class="material-symbols-outlined">
                            redeem
                        </span>
                    </div>

                    <h2>
                        Choose Your Wrapping
                    </h2>

                </div>

                <div class="custom-options">

                    @foreach (var wrapping in ViewBag.Wrappings)
                    {
                        <div class="custom-option">

                            <input type="radio"
                                   asp-for="WrappingID"
                                   value="@wrapping.WrappingID"
                                   id="wrapping-@wrapping.WrappingID" />

                            <label for="wrapping-@wrapping.WrappingID">

                                <span class="option-name">
                                    @wrapping.Name
                                </span>

                                <span class="option-price">
                                    @wrapping.Price EGP
                                </span>

                            </label>

                        </div>
                    }

                </div>

                <span asp-validation-for="WrappingID"
                      class="text-danger">
                </span>

            </div>


            <!-- Flowers -->
            <div class="custom-card">

                <div class="custom-section-title">

                    <div class="custom-icon">
                        <span class="material-symbols-outlined">
                            local_florist
                        </span>
                    </div>

                    <h2>
                        Select Your Flowers
                    </h2>

                </div>

                <p class="custom-subtitle"
                   style="margin: 0 0 20px 0;">
                    Choose the flowers you would like to include
                    in your arrangement.
                </p>

                <div class="custom-options">

                    @foreach (var flower in ViewBag.Flowers)
                    {
                        <div class="custom-option">

                            <input type="checkbox"
                                   name="FlowerIDs"
                                   value="@flower.FlowerID"
                                   id="flower-@flower.FlowerID" />

                            <label for="flower-@flower.FlowerID">

                                <span class="option-name">
                                    @flower.Name
                                </span>

                                <span class="option-price">
                                    @flower.BasePrice EGP
                                </span>

                            </label>

                        </div>
                    }

                </div>

                <span asp-validation-for="FlowerIDs"
                      class="text-danger">
                </span>

            </div>


            <!-- Colors -->
            <div class="custom-card">

                <div class="custom-section-title">

                    <div class="custom-icon">
                        <span class="material-symbols-outlined">
                            palette
                        </span>
                    </div>

                    <h2>
                        Choose Flower Colors
                    </h2>

                </div>

                <div class="custom-options">

                    @foreach (var color in ViewBag.Colors)
                    {
                        <div class="custom-option">

                            <input type="checkbox"
                                   name="FlowerColorIDs"
                                   value="@color.FlowerColorID"
                                   id="color-@color.FlowerColorID" />

                            <label for="color-@color.FlowerColorID">

                                <span class="option-name">
                                    @color.Color
                                </span>

                            </label>

                        </div>
                    }

                </div>

            </div>


            <!-- Add Ons -->
            <div class="custom-card">

                <div class="custom-section-title">

                    <div class="custom-icon">
                        <span class="material-symbols-outlined">
                            add_circle_outline
                        </span>
                    </div>

                    <h2>
                        Add Special Touches
                    </h2>

                </div>

                <div class="custom-options">

                    @foreach (var addon in ViewBag.AddOns)
                    {
                        <div class="custom-option">

                            <input type="checkbox"
                                   name="AddOnIDs"
                                   value="@addon.AddOnID"
                                   id="addon-@addon.AddOnID" />

                            <label for="addon-@addon.AddOnID">

                                <span class="option-name">
                                    @addon.Name
                                </span>

                                <span class="option-price">
                                    + @addon.Price EGP
                                </span>

                            </label>

                        </div>
                    }

                </div>

            </div>


            <!-- Submit -->
            <div class="custom-actions">

                <button type="submit"
                        class="custom-submit">

                    Create My Bouquet

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}