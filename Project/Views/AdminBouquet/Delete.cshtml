@model Project.DAL.Entities.Bouquet

@{
    ViewData["Title"] = "Delete Bouquet";
}

<h1>Delete Bouquet</h1>

<h3>Are you sure you want to delete this bouquet?</h3>

<div class="card mt-3 mb-3">
    <div class="card-body">

        <h4>@Model.Name</h4>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Price:</strong>
            @Model.Price
        </p>

        <p>
            <strong>Preparation Time:</strong>
            @Model.PreparationTime
        </p>

        <p>
            <strong>Size:</strong>
            @Model.BouquetSize?.Size
        </p>

    </div>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="BouquetID" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>