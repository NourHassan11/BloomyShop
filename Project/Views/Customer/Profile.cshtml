        .bloomy-step-circle.step-done {
            background-color: #37634F;
            color: #FFFFFF;
            box-shadow: 0 2px 6px rgba(55, 99, 79, 0.25);
        }

        .bloomy-step-circle.step-active {
            background-color: #8F3D56;
            color: #FFFFFF;
            box-shadow: 0 0 0 4px #F5E5EA;
        }

        .bloomy-step-circle.step-future {
            background-color: #FFFFFF;
            border: 2px dashed #D6C9C0;
