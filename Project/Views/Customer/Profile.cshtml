            background: #FFFFFF;
            border: 1px solid var(--bloomy-border-card);
            border-radius: 14px;
            padding: 1.25rem 0.875rem;
            box-shadow: 0 2px 8px rgba(44,36,32,0.02);
            margin-bottom: 1.25rem;
        }

        .bloomy-sidebar-section-title {
            font-family: var(--font-sans);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: #9C8E88;
            text-transform: uppercase;
            padding: 0.5rem 0.875rem 0.35rem;
            margin: 0;
        }

        .bloomy-sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem;
        }

        .bloomy-sidebar-nav:last-child {
            margin-bottom: 0;
        }

        .bloomy-sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.6rem 0.875rem;
            border-radius: 8px;
            color: #3E342F;
