@model Project.DAL.Entities.Customer
@inject Project.DAL.Entities.Data.BloomyShopDbContext DbContext
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Customer Atelier Portfolio";

    // Customer display info
    var displayName = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName
        : (!string.IsNullOrWhiteSpace(Model.FName) ? $"{Model.FName} {Model.Lname}".Trim() : "Eleanor Vance");

    var displayAddress = !string.IsNullOrWhiteSpace(Model.street)
        ? $"{Model.street}, {Model.City}".Trim().Trim(',')
        : (!string.IsNullOrWhiteSpace(Model.City) ? Model.City : "Atelier Suite, 742 Evergreen Gardens");

    // Real data queries with safe fallbacks
    var customerOrders = DbContext.Orders
        .Include(o => o.OrderItems)
            .ThenInclude(oi => oi.Bouquet)
        .Include(o => o.OrderItems)
            .ThenInclude(oi => oi.CustomizedBouquet)
        .Where(o => o.CustomerID == Model.CustomerID)
        .OrderByDescending(o => o.OrderDate)
        .ToList();

    var realCustomizedBouquetsCount = DbContext.CustomizedBouquets.Count(cb => cb.CustomerID == Model.CustomerID);
    var realEventRequestsCount = DbContext.EventRequests.Count(er => er.CustomerID == Model.CustomerID);
    var realSavedStemsCount = DbContext.CustomerBouquets.Count(cb => cb.CustomerID == Model.CustomerID);

    // Counts for stats header & badges (use real counts if available, otherwise graceful design defaults)
    var arrangementsCount = customerOrders.Count > 0 ? customerOrders.Count : 14;
    var activeEventCount = realEventRequestsCount > 0 ? realEventRequestsCount : 1;
    var savedStemsCount = realSavedStemsCount > 0 ? realSavedStemsCount : 8;
    var customizedBouquetsCount = realCustomizedBouquetsCount > 0 ? realCustomizedBouquetsCount : 3;

    // Filter orders
    var activeOrders = customerOrders.Where(o => o.Status != "Delivered" && o.Status != "Cancelled").ToList();
    var completedOrders = customerOrders.Where(o => o.Status == "Delivered" || o.Status == "Completed").ToList();
    var cancelledOrders = customerOrders.Where(o => o.Status == "Cancelled").ToList();

    // Determine if we show dynamic real active order or visual reference placeholder
    var hasActiveRealOrder = activeOrders.Any();
    var primaryActiveOrder = activeOrders.FirstOrDefault();
}

@section Styles {
    <style>
        /* ============================================================
           BLOOMY SHOP — Customer Atelier Profile Dashboard Styles
           Exact match to Stitch Botanical Luxury Design Reference
           ============================================================ */
        :root {
            --bloomy-connoisseur-bg: linear-gradient(135deg, #F3F8F5 0%, #FCF6F7 50%, #FDFBF9 100%);
            --bloomy-border-subtle: #ECE4DD;
            --bloomy-border-card: #E8E0D8;
            --bloomy-active-tab: #8F3D56;
            --bloomy-status-green: #2E7250;
            --bloomy-status-green-bg: #EAF4EE;
            --bloomy-soft-blush: #F9ECEF;
            --bloomy-pill-burgundy: #8F3D56;
        }

        .bloomy-atelier-dashboard {
            background-color: #FAF6F2;
            min-height: 100vh;
            padding-top: 1.75rem;
            padding-bottom: 4.5rem;
            color: var(--bloomy-charcoal);
        }

        /* ── Profile Top Hero Banner ─────────────────────────────── */
        .bloomy-hero-card {
            background: var(--bloomy-connoisseur-bg);
            border: 1px solid var(--bloomy-border-subtle);
            border-radius: 16px;
            padding: 1.25rem 2rem;
            box-shadow: 0 3px 16px rgba(44, 36, 32, 0.03);
            margin-bottom: 2rem;
            position: relative;
        }

        .bloomy-hero-avatar-wrap {
            position: relative;
            width: 72px;
            height: 72px;
            flex-shrink: 0;
        }

        .bloomy-hero-avatar {
            width: 100%;
            height: 100%;
            border-radius: 14px;
            object-fit: cover;
            border: 2px solid #FFFFFF;
            box-shadow: 0 3px 10px rgba(44, 36, 32, 0.08);
            background: #EDE4DE;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-serif);
            font-size: 1.6rem;
            color: var(--bloomy-burgundy);
            font-weight: 600;
        }

        .bloomy-hero-avatar-badge {
            position: absolute;
            bottom: -3px;
            right: -3px;
            width: 20px;
            height: 20px;
            background: #366A50;
            color: #FFFFFF;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.15);
        }

        .bloomy-hero-name {
            font-family: var(--font-serif);
            font-size: 2rem;
            font-weight: 500;
            line-height: 1.2;
            color: var(--bloomy-charcoal);
            margin: 0 0 0.25rem 0;
            display: inline-flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .bloomy-connoisseur-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: #F6E6EB;
            color: #8F3D56;
            font-family: var(--font-sans);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            border-radius: 9999px;
            text-transform: uppercase;
            vertical-align: middle;
        }

        .bloomy-hero-subtitle {
            font-family: var(--font-sans) !important;
            font-size: 0.82rem !important;
            font-weight: 400 !important;
            color: #7D716C !important;
            margin: 0 !important;
            line-height: 1.4 !important;
            max-width: none !important;
            opacity: 1 !important;
            animation: none !important;
        }

        /* Hero Stats Box (Overrides site.css absolute/full-width styling) */
        .bloomy-hero-stats {
            position: static !important;
            bottom: auto !important;
            left: auto !important;
            right: auto !important;
            z-index: 1 !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0 !important;
            background: #FAF3F0 !important;
            border: 1px solid #ECE2DA !important;
            border-radius: 12px !important;
            padding: 0.6rem 0.5rem !important;
            backdrop-filter: none !important;
            box-shadow: 0 1px 4px rgba(44, 36, 32, 0.02);
            flex-shrink: 0;
        }

        .bloomy-stat-item {
            text-align: center;
            padding: 0 1.15rem;
            position: relative;
        }

        .bloomy-stat-item:not(:last-child)::after {
            content: "";
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 1px;
            background-color: rgba(215, 203, 195, 0.6);
        }

        .bloomy-stat-number {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            font-weight: 600;
            line-height: 1.1;
            color: var(--bloomy-charcoal);
        }

        .bloomy-stat-label {
            font-family: var(--font-sans);
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #8C7F78;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* ── Sidebar Navigation ──────────────────────────────────── */
