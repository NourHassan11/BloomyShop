            border-top: 1px solid #EFE6E0;
            padding-top: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .bloomy-tracker-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .bloomy-tracker-title {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.9px;
            color: #8C7F78;
            text-transform: uppercase;
        }

        .bloomy-tracker-vehicle {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.7rem;
            font-weight: 600;
            color: #6E615B;
        }

        .bloomy-timeline-track {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin-bottom: 0.5rem;
        }

        .bloomy-timeline-track::before {
            content: "";
            position: absolute;
            top: 15px;
            left: 5%;
            right: 5%;
            height: 2px;
            background: #E8DED8;
