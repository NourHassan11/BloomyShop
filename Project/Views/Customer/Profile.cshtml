        }

        .bloomy-step-state {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: #9C8E88;
            margin-bottom: 2px;
        }

        .bloomy-step-state.active-label {
            color: #8F3D56;
        }

        .bloomy-step-name {
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
            margin-bottom: 1px;
            line-height: 1.2;
        }

        .bloomy-step-time {
            font-size: 0.68rem;
            color: #8E827B;
        }

        /* ── Active Delivery Action Bar ──────────────────────────── */
        .bloomy-delivery-footer-actions {
            border-top: 1px solid #EFE6E0;
            padding-top: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .bloomy-freshness-guarantee {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.74rem;
            color: #72655E;
            font-weight: 500;
        }

        .bloomy-action-btns-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .bloomy-btn-outline {
            background-color: #FFFFFF;
            border: 1px solid #D6CBC2;
            color: #382E29;
            font-size: 0.73rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 0.55rem 1rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .bloomy-btn-outline:hover {
            border-color: #8F3D56;
            color: #8F3D56;
            background-color: #FAF4F2;
        }

        .bloomy-btn-burgundy {
            background-color: #8F3D56;
            border: 1px solid #8F3D56;
            color: #FFFFFF;
            font-size: 0.73rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 0.55rem 1.15rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .bloomy-btn-burgundy:hover {
            background-color: #722F43;
            border-color: #722F43;
            color: #FFFFFF;
        }

        /* ── Recent Atelier Archives ─────────────────────────────── */
        .bloomy-archives-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .bloomy-archives-title {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
            margin: 0;
        }

        .bloomy-browse-all-link {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.7px;
            color: #8F3D56;
            text-transform: uppercase;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .bloomy-browse-all-link:hover {
            text-decoration: underline;
        }

        .bloomy-archive-card {
            background: #FFFFFF;
            border: 1px solid var(--bloomy-border-card);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 2px 10px rgba(44, 36, 32, 0.02);
            transition: box-shadow 0.2s ease;
        }

        .bloomy-archive-card:hover {
            box-shadow: 0 4px 16px rgba(44, 36, 32, 0.05);
        }

        .bloomy-archive-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 0.85rem;
            border-bottom: 1px solid #F0E8E2;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .bloomy-archive-meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.82rem;
            color: #554A44;
            font-weight: 500;
        }

        .bloomy-archive-badge-delivered {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.4px;
            padding: 2px 8px;
            border-radius: 999px;
            background: #E8F3ED;
            color: #2D6B49;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .bloomy-archive-price {
            font-family: var(--font-serif);
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
        }

        .bloomy-archive-body {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .bloomy-archive-item-info {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            flex-grow: 1;
        }

        .bloomy-archive-thumb {
            width: 72px;
            height: 72px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
            border: 1px solid #ECE3DC;
        }

        .bloomy-archive-details h5 {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
            margin: 0 0 0.3rem;
        }

        .bloomy-archive-desc {
            font-size: 0.75rem;
            color: #6C5F58;
            margin-bottom: 0.35rem;
            line-height: 1.4;
        }

        .bloomy-archive-sub {
            font-size: 0.7rem;
            color: #8C7F78;
        }

        .bloomy-archive-actions {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex-shrink: 0;
            min-width: 140px;
        }

        .bloomy-archive-actions .bloomy-btn-outline,
        .bloomy-archive-actions .bloomy-btn-burgundy {
            padding: 0.42rem 0.85rem;
            font-size: 0.68rem;
            justify-content: center;
            width: 100%;
        }

        /* ── VIP Tier Rewards Card ───────────────────────────────── */
        .bloomy-rewards-banner {
            background: linear-gradient(135deg, #FAF4F0 0%, #F5EAE4 100%);
            border: 1px solid #EADBCE;
            border-radius: 14px;
            padding: 1.25rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-top: 1.75rem;
        }

        .bloomy-rewards-left {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .bloomy-rewards-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: #8F3D56;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 3px 8px rgba(143, 61, 86, 0.25);
        }

        .bloomy-rewards-title {
            font-family: var(--font-serif);
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
            margin: 0 0 0.2rem;
        }

        .bloomy-rewards-text {
            font-size: 0.76rem;
            color: #6C5F59;
            margin: 0;
        }

        .bloomy-btn-vip {
            background: #FFFFFF;
            border: 1px solid #D8CFC8;
            color: #4A3E39;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.7px;
            padding: 0.5rem 1.25rem;
            border-radius: 999px;
            text-transform: uppercase;
            white-space: nowrap;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .bloomy-btn-vip:hover {
            border-color: #8F3D56;
            color: #8F3D56;
        }

        /* ── Modals & Notifications ──────────────────────────────── */
        .bloomy-custom-modal .modal-content {
            border-radius: 16px;
            border: 1px solid var(--bloomy-border-card);
            box-shadow: 0 16px 48px rgba(44, 36, 32, 0.12);
        }

        .bloomy-custom-modal .modal-header {
            border-bottom: 1px solid #F0E8E2;
            padding: 1.25rem 1.5rem;
        }

        .bloomy-custom-modal .modal-title {
            font-family: var(--font-serif);
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
        }

        /* ── Responsive Refinements ──────────────────────────────── */
        @@media (max-width: 991.98px) {
            .bloomy-hero-card {
                padding: 1.25rem;
            }
            .bloomy-hero-card > .d-flex {
                flex-direction: column;
                gap: 1.25rem;
                align-items: flex-start !important;
            }
            .bloomy-hero-stats {
                width: 100% !important;
                justify-content: space-around !important;
                padding: 0.75rem 0.5rem !important;
            }
            .bloomy-stat-item {
                padding: 0 0.5rem;
            }
            .bloomy-archive-body {
                flex-direction: column;
                align-items: flex-start;
            }
            .bloomy-archive-actions {
                width: 100%;
                flex-direction: row;
            }
            .bloomy-rewards-banner {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 575.98px) {
            .bloomy-item-showcase {
                flex-direction: column;
            }
            .bloomy-item-thumb-wrap {
                width: 100%;
                height: 180px;
            }
            .bloomy-delivery-footer-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .bloomy-action-btns-group {
                flex-direction: column;
                width: 100%;
            }
            .bloomy-action-btns-group a,
            .bloomy-action-btns-group button {
                width: 100%;
                justify-content: center;
            }
            .bloomy-timeline-track {
                overflow-x: auto;
                padding-bottom: 0.5rem;
            }
            .bloomy-timeline-step {
                min-width: 90px;
            }
        }
    </style>
}

<div class="bloomy-atelier-dashboard">
    <div class="container-xl">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- 1. TOP PROFILE HERO BANNER                                 -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <div class="bloomy-hero-card">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                
                <!-- Left: Avatar, Name & Connoisseur Badge -->
                <div class="d-flex align-items-center gap-3">
                    <div class="bloomy-hero-avatar-wrap">
                        <img src="~/images/hero_floral.jpg" alt="@displayName" class="bloomy-hero-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="bloomy-hero-avatar" style="display: none;">
                            @displayName.Substring(0, 1).ToUpper()
                        </div>
                        <span class="bloomy-hero-avatar-badge" title="Verified Botanical Patron">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                    </div>

                    <div>
                        <div class="bloomy-hero-name">
                            <span>@displayName</span>
                            <span class="bloomy-connoisseur-pill">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="12" r="10"></circle>
                                </svg>
                                Botanical Connoisseur [VIP]
                            </span>
                        </div>
                        <p class="bloomy-hero-subtitle">
                            Member since 2024 &bull; Private Patron Salon
                        </p>
                    </div>
                </div>

                <!-- Right: Stats Counters (Compact box matching Stitch design) -->
                <div class="bloomy-hero-stats">
                    <div class="bloomy-stat-item">
                        <div class="bloomy-stat-number">@arrangementsCount</div>
                        <div class="bloomy-stat-label">Arrangements</div>
                    </div>
                    <div class="bloomy-stat-item">
                        <div class="bloomy-stat-number">@activeEventCount</div>
                        <div class="bloomy-stat-label">Active Event</div>
                    </div>
                    <div class="bloomy-stat-item">
                        <div class="bloomy-stat-number">@savedStemsCount</div>
                        <div class="bloomy-stat-label">Saved Stems</div>
                    </div>
                </div>

            </div>
        </div>


        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- 2. TWO-COLUMN ATELIER LAYOUT                               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <div class="row g-4">

            <!-- ── LEFT SIDEBAR ───────────────────────────────────── -->
            <div class="col-lg-4 col-xl-3">
                
                <!-- Navigation Card -->
                <div class="bloomy-sidebar-card">
                    
                    <div class="bloomy-sidebar-section-title">Atelier Portfolio</div>
                    <ul class="bloomy-sidebar-nav">
                        <li>
                            <a href="#orders" class="bloomy-sidebar-link active">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                                    </svg>
                                    My Orders
                                </span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="CustomizedBouquet" asp-action="Customize" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                                    </svg>
                                    Customized Bouquets
                                </span>
                                <span class="bloomy-sidebar-badge">@customizedBouquetsCount saved</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="EventRequest" asp-action="Create" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    Event Styling Requests
                                </span>
                                <span class="bloomy-sidebar-badge badge-pending">1 Pending</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Bouquet" asp-action="Index" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                    Wishlist &amp; Stems
                                </span>
                                <span class="bloomy-sidebar-badge">@savedStemsCount items</span>
                            </a>
                        </li>
                    </ul>

                    <div class="bloomy-sidebar-section-title">Preferences</div>
                    <ul class="bloomy-sidebar-nav">
                        <li>
                            <a asp-action="Edit" asp-route-id="@Model.CustomerID" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    Delivery Addresses
                                </span>
                                <span class="bloomy-sidebar-badge">2 saved</span>
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0)" onclick="alert('Stored payment methods are secured via Tokenized Vault.')" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                    </svg>
                                    Payment Methods
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0)" onclick="alert('Notification settings updated: SMS &amp; Email courier dispatches active.')" class="bloomy-sidebar-link">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                    Notification Settings
                                </span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Customer" asp-action="Login" class="bloomy-sidebar-link text-danger">
                                <span class="bloomy-sidebar-icon-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    Sign Out
                                </span>
                            </a>
                        </li>
                    </ul>

                </div>

                <!-- Atelier Lead Florist Card -->
                <div class="bloomy-concierge-card">
                    <div class="bloomy-concierge-header">
                        <img src="~/images/hero_floral.jpg" alt="Marc Coste" class="bloomy-concierge-avatar" />
                        <div>
                            <div class="bloomy-concierge-role">Atelier Lead Florist</div>
                            <h4 class="bloomy-concierge-name">Marc Coste</h4>
                        </div>
                    </div>
                    <p class="bloomy-concierge-text">
                        Planning a private dinner, estate installation, or custom stem conditioning? Your personal florist is on standby.
                    </p>
                    <button type="button" class="bloomy-btn-concierge" data-bs-toggle="modal" data-bs-target="#conciergeModal">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        MESSAGE CONCIERGE
                    </button>
                </div>

                <!-- Botanist's Tip of the Week -->
                <div class="bloomy-tip-card">
                    <div class="bloomy-tip-header">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#8F3D56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        Botanist's Tip of the Week
                    </div>
                    Trim ranunculus stems diagonally under lukewarm water every 48 hours to prolong vase longevity up to 8 days.
                </div>

            </div>


            <!-- ── RIGHT MAIN CONTENT ─────────────────────────────── -->
            <div class="col-lg-8 col-xl-9">

                <!-- Tabs & Sort Navigation -->
                <div class="bloomy-order-tabs-bar">
                    <div class="bloomy-order-tabs-group">
                        <button type="button" class="bloomy-tab-btn active" onclick="switchOrderTab('active')">
                            Active Deliveries
                            <span class="bloomy-tab-count">@(hasActiveRealOrder ? activeOrders.Count : 1)</span>
                        </button>
                        <button type="button" class="bloomy-tab-btn" onclick="switchOrderTab('completed')">
                            Completed Orders
                            <span class="bloomy-tab-count">@(completedOrders.Count > 0 ? completedOrders.Count : 12)</span>
                        </button>
                        <button type="button" class="bloomy-tab-btn" onclick="switchOrderTab('cancelled')">
                            Cancelled
                            <span class="bloomy-tab-count">@cancelledOrders.Count</span>
                        </button>
                    </div>

                    <button type="button" class="bloomy-sort-btn" data-bs-toggle="modal" data-bs-target="#sortFilterModal">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" y1="21" x2="4" y2="14"></line>
                            <line x1="4" y1="10" x2="4" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12" y2="3"></line>
                            <line x1="20" y1="21" x2="20" y2="16"></line>
                            <line x1="20" y1="12" x2="20" y2="3"></line>
                            <line x1="1" y1="14" x2="7" y2="14"></line>
                            <line x1="9" y1="8" x2="15" y2="8"></line>
                            <line x1="17" y1="16" x2="23" y2="16"></line>
                        </svg>
                        SORT &amp; FILTER
                    </button>
                </div>


                <!-- ── ACTIVE DELIVERIES TAB CONTENT ──────────────── -->
                <div id="tabContentActive">
                    
                    <div class="bloomy-active-delivery-card">
                        
                        <!-- Status & Total Row -->
                        <div class="bloomy-delivery-top-row">
                            <div class="bloomy-live-status-pill">
                                <span class="bloomy-live-dot"></span>
                                EN ROUTE VIA CHILLED COURIER
                            </div>
                            <div class="bloomy-order-total-block">
                                <div class="bloomy-total-label">Order Total</div>
                                <div class="bloomy-total-amount">
                                    @(hasActiveRealOrder ? $"${primaryActiveOrder!.TotalPrice:N2}" : "$151.00")
                                </div>
                            </div>
                        </div>

                        <!-- Order ID & Placed Date -->
                        <h3 class="bloomy-order-title">
                            Order #@(hasActiveRealOrder ? $"BLM-{primaryActiveOrder!.OrderID}" : "BLM-9842")
                        </h3>
                        <p class="bloomy-order-date-type">
                            Placed @(hasActiveRealOrder ? primaryActiveOrder!.OrderDate.ToString("MMM dd, yyyy") : "Oct 24, 2026") &bull; Bespoke Express Delivery
                        </p>

                        <!-- Highlight Item Showcase -->
                        <div class="bloomy-item-showcase">
                            <div class="bloomy-item-thumb-wrap">
                                <img src="~/images/stem_pink_romance.jpg" alt="Pink Romance Bouquet" class="bloomy-item-thumb" />
                                <span class="bloomy-item-tag">Fresh Batch</span>
                            </div>

                            <div class="bloomy-item-details">
                                <div class="bloomy-item-category">Signature Medium Size</div>
                                <h4 class="bloomy-item-name">Pink Romance Bouquet</h4>
                                <p class="bloomy-item-desc">
                                    Featuring Colombian blush garden roses, deep raspberry ranunculus, fluttery sweet peas, and fresh silver dollar eucalyptus tied with Belgian frayed silk ribbon.
                                </p>
                                <div class="bloomy-item-meta-row">
                                    <span class="bloomy-meta-info">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        Deliver to: @displayName (@displayAddress)
                                    </span>
                                    <span class="bloomy-meta-info">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        Est. Arrival: 11:30 AM Today
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Botanical Fulfillment Progress Track -->
                        <div class="bloomy-tracker-section">
                            <div class="bloomy-tracker-header">
                                <div class="bloomy-tracker-title">Botanical Fulfillment Progress</div>
                                <div class="bloomy-tracker-vehicle">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="3" width="15" height="13"></rect>
                                        <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                    </svg>
                                    CHILLED VAN #04 (48&deg;F)
                                </div>
                            </div>

                            <div class="bloomy-timeline-track">
                                
                                <!-- Step 1 -->
                                <div class="bloomy-timeline-step">
                                    <div class="bloomy-step-circle step-done">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </div>
                                    <div class="bloomy-step-state">Step 1</div>
                                    <div class="bloomy-step-name">Harvest &amp; Conditioning</div>
                                    <div class="bloomy-step-time">Completed 08:15 AM</div>
