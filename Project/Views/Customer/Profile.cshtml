<!-- Concierge Message Modal -->
<div class="modal fade bloomy-custom-modal" id="conciergeModal" tabindex="-1" aria-labelledby="conciergeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="conciergeModalLabel">Atelier Concierge Florist</h5>
                    <small class="text-muted">Marc Coste &bull; Master Florist on Standby</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">
                    Submit custom inquiries regarding bespoke dinner centerpieces, wedding arch specs, or stem conditioning adjustments for your active orders.
                </p>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase" style="letter-spacing:0.5px;">Topic / Occasion</label>
                    <select class="form-select form-select-sm">
                        <option>Active Order #BLM-9842 Inquiry</option>
                        <option>Private Estate Dinner Consultation</option>
                        <option>Bespoke Stem Sourcing &amp; Color Match</option>
                        <option>Vase Conditioning &amp; Care Advice</option>
                    </select>
                </div>
