            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .bloomy-concierge-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #D8CEC6;
        }

        .bloomy-concierge-role {
            font-size: 0.64rem;
            letter-spacing: 0.8px;
            font-weight: 700;
            color: #8A7B74;
            text-transform: uppercase;
            line-height: 1.1;
        }

        .bloomy-concierge-name {
            font-family: var(--font-serif);
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--bloomy-charcoal);
            margin: 0;
        }

        .bloomy-concierge-text {
            font-size: 0.76rem;
            line-height: 1.45;
            color: #6C5F59;
            margin-bottom: 1rem;
        }

        .bloomy-btn-concierge {
            width: 100%;
            background-color: #8F3D56;
            color: #FFFFFF;
            border: none;
            border-radius: 6px;
            padding: 0.55rem 0.75rem;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: background-color 0.2s ease;
        }

        .bloomy-btn-concierge:hover {
            background-color: #722F43;
            color: #FFFFFF;
        }

        .bloomy-tip-card {
            background: #FDFBF8;
            border: 1px dashed #DDD2C8;
            border-radius: 14px;
            padding: 1.1rem;
            font-size: 0.75rem;
            color: #6E625B;
        }

        .bloomy-tip-header {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.66rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #8A7B74;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        /* ── Tabs & Filter Header ────────────────────────────────── */
        .bloomy-order-tabs-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--bloomy-border-card);
            margin-bottom: 1.5rem;
            padding-bottom: 0;
        }

        .bloomy-order-tabs-group {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: -1px;
        }

        .bloomy-tab-btn {
            background: none;
            border: none;
            padding: 0.65rem 0.25rem 0.85rem;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            color: #8A7E79;
            text-transform: uppercase;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .bloomy-tab-btn:hover {
            color: var(--bloomy-burgundy);
        }

        .bloomy-tab-btn.active {
            color: #8F3D56;
            border-bottom-color: #8F3D56;
        }

        .bloomy-tab-count {
            font-size: 0.68rem;
            font-weight: 600;
            padding: 1px 6px;
            border-radius: 999px;
            background: #EFE8E3;
            color: #6F625D;
        }

        .bloomy-tab-btn.active .bloomy-tab-count {
            background: #F8E5EB;
            color: #8F3D56;
        }

        .bloomy-sort-btn {
            background: none;
            border: none;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #7D706A;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            cursor: pointer;
            padding: 0.4rem 0.6rem;
            border-radius: 4px;
            transition: background 0.2s;
        }

        .bloomy-sort-btn:hover {
            background-color: #ECE3DC;
        }

        /* ── Active Delivery Card ────────────────────────────────── */
        .bloomy-active-delivery-card {
            background: #FFFFFF;
            border: 1px solid var(--bloomy-border-card);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: 0 4px 18px rgba(44, 36, 32, 0.03);
            margin-bottom: 2.25rem;
        }

        .bloomy-delivery-top-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .bloomy-live-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #276947;
            text-transform: uppercase;
        }

        .bloomy-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #276947;
            box-shadow: 0 0 0 3px rgba(39, 105, 71, 0.2);
            animation: bloomyPulse 2s infinite;
        }

        @@keyframes bloomyPulse {
            0% { box-shadow: 0 0 0 0 rgba(39, 105, 71, 0.4); }
            70% { box-shadow: 0 0 0 6px rgba(39, 105, 71, 0); }
            100% { box-shadow: 0 0 0 0 rgba(39, 105, 71, 0); }
        }

        .bloomy-order-total-block {
            text-align: right;
        }

        .bloomy-total-label {
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.9px;
            color: #968983;
            text-transform: uppercase;
            margin-bottom: 1px;
        }

        .bloomy-total-amount {
            font-family: var(--font-serif);
            font-size: 1.6rem;
            font-weight: 600;
            color: #8F3D56;
            line-height: 1;
        }

        .bloomy-order-title {
            font-family: var(--font-serif);
            font-size: 1.55rem;
            font-weight: 500;
            color: var(--bloomy-charcoal);
            margin: 0;
            line-height: 1.2;
        }

        .bloomy-order-date-type {
            font-size: 0.78rem;
            color: #8A7E78;
            margin-top: 0.25rem;
            margin-bottom: 1.25rem;
        }

        /* ── Delivery Item Showcase Box ──────────────────────────── */
        .bloomy-item-showcase {
            background: #FAF3F5;
            border: 1px solid #F2E3E8;
            border-radius: 12px;
            padding: 1.25rem;
