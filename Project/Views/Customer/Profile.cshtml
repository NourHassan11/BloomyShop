@section Scripts {
    <script>
        function switchOrderTab(tabName) {
            const tabs = document.querySelectorAll('.bloomy-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));

            const activeContainer = document.getElementById('tabContentActive');
            const archivesSection = document.querySelector('.bloomy-archives-section');

            if (tabName === 'active') {
                event.currentTarget.classList.add('active');
                if (activeContainer) activeContainer.style.display = 'block';
                if (archivesSection) archivesSection.style.display = 'block';
            } else if (tabName === 'completed') {
                event.currentTarget.classList.add('active');
                if (activeContainer) activeContainer.style.display = 'none';
                if (archivesSection) archivesSection.style.display = 'block';
            } else if (tabName === 'cancelled') {
                event.currentTarget.classList.add('active');
                if (activeContainer) activeContainer.style.display = 'none';
                if (archivesSection) archivesSection.style.display = 'none';
            }
        }
    </script>
}
